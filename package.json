{
  "name": "aventurine-planner",
  "version": "0.1.0",
  "description": "Aventurine Planner: a private financial outlook simulator that runs in the browser. Plans are stored in the visitor's own browser.",
  "private": true,
  "author": "Aventurine <chatgpt.flattered848@passmail.net>",
  "homepage": "https://aventurine-app.com",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/dev-server.js",
    "build": "node scripts/build.js",
    "test": "node --test",
    "lint": "eslint .",
    "verify": "electron scripts/verify.js --no-sandbox",
    "icons:ui": "node scripts/make-ui-icons.js",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "npm run build && wrangler deploy --config worker/wrangler.toml",
    "worker:smoke": "node scripts/smoke-worker.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@phosphor-icons/core": "^2.1.1",
    "electron": "^41.10.7",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "wrangler": "^4.0.0"
  }
}
